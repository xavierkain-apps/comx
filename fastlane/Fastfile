# fastlane — signed build + TestFlight upload, entirely from GitHub Actions.
#
# Mirrors the setup already proven on LiveXWind so the same App Store Connect
# key and the same match certificates work here.
#
# Required GitHub secrets (Settings > Secrets and variables > Actions):
#   APPLE_TEAM_ID       — Apple Developer team ID
#   ASC_KEY_ID          — App Store Connect API key ID
#   ASC_ISSUER_ID       — Issuer ID (App Store Connect > Users > Integrations)
#   ASC_KEY_P8_BASE64   — the .p8 contents, base64 encoded
#   MATCH_PASSWORD      — passphrase encrypting the shared match storage
#   MATCH_GIT_URL       — repository holding the shared certificates
#   MATCH_GIT_TOKEN     — PAT with write access to that repository (the default
#                         GITHUB_TOKEN is scoped to this repo and cannot push there)
#
# Apple caps distribution certificates at 3 per team, so every app in the account
# shares ONE identity, held in xavierkain-apps/apple-certs. match reads it from
# there and only creates the missing provisioning profile for this bundle ID.
# Creating a per-app certificate is what exhausted the cap previously.

default_platform(:ios)

# ComX: a separate app from SoarX Voice, built from the same code.
APP_ID = "com.xavier.comx"
APP_NAME = "SoarXVoice"
# Apple Watch companion, embedded in the iOS app (docs/watch-ios.md).
WATCH_APP_ID = "#{APP_ID}.watchkitapp"
WATCH_TARGET = "SoarXVoiceWatch"
# Talk control for the Ultra Action button (WidgetKit extension in the watch app).
CONTROLS_APP_ID = "#{WATCH_APP_ID}.controls"
CONTROLS_TARGET = "SoarXVoiceWatchControls"

platform :ios do
  desc "List the distribution certificates on the account"
  lane :list_certs do
    require "spaceship"
    require "base64"

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
    )

    certs = Spaceship::ConnectAPI::Certificate.all
    UI.important("#{certs.count} certificate(s) on the account:")
    certs.sort_by { |c| c.certificate_type.to_s }.each do |c|
      UI.message(
        "  [#{c.certificate_type}] #{c.display_name} " \
        "| id=#{c.id} | serial=#{c.serial_number} | expires #{c.expiration_date}"
      )
    end

    dist = certs.select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") }
    UI.important("#{dist.count} distribution certificate(s) — this is what Apple caps.")
  end

  desc "Show TestFlight groups, testers and account users"
  lane :testflight_status do
    require "spaceship"
    require "base64"

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
    )

    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.important("App: #{app.name} (#{app.bundle_id}) id=#{app.id}")

    # Read through the REST API: spaceship's get_beta_testers returned an empty
    # list for a group that the API had just accepted a tester into.
    require "net/http"
    require "json"

    def asc_get(path)
      uri = URI("https://api.appstoreconnect.apple.com/#{path}")
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
      JSON.parse(res.body)
    end

    UI.important("--- Beta groups ---")
    asc_get("v1/apps/#{app.id}/betaGroups")["data"].each do |g|
      kind = g["attributes"]["isInternalGroup"] ? "INTERNAL" : "EXTERNAL"
      testers = asc_get("v1/betaGroups/#{g['id']}/betaTesters")["data"] || []
      UI.message("[#{kind}] \"#{g['attributes']['name']}\" id=#{g['id']} — #{testers.count} tester(s)")
      testers.each do |t|
        a = t["attributes"]
        UI.message("     - #{a['email']} (#{a['firstName']} #{a['lastName']}) state=#{a['state']} invite=#{a['inviteType']}")
      end
    end

    UI.important("--- Recent builds ---")
    builds = asc_get("v1/builds?filter[app]=#{app.id}&limit=5&sort=-uploadedDate")["data"] || []
    builds.each do |b|
      a = b["attributes"]
      UI.message("  build #{a['version']} | state=#{a['processingState']} | expired=#{a['expired']} | uploaded #{a['uploadedDate']}")
    end

    UI.important("--- All beta testers on the app ---")
    (asc_get("v1/apps/#{app.id}/betaTesters")["data"] || []).each do |t|
      a = t["attributes"]
      UI.message("  #{a['email']} state=#{a['state']} invite=#{a['inviteType']}")
    end

    UI.important("--- App Store Connect users ---")
    Spaceship::ConnectAPI::User.all.each do |u|
      addr = (u.respond_to?(:email) && u.email) || (u.respond_to?(:username) && u.username)
      UI.message("  #{addr} | #{u.first_name} #{u.last_name} | roles=#{u.roles.join(',')}")
    end
  end

  desc "Delete App Store provisioning profiles for given bundle IDs"
  lane :delete_profiles do |options|
    require "spaceship"
    require "base64"

    ids = (options[:ids] || "").split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("Pass ids:com.a,com.b") if ids.empty?

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
    )

    # Profiles are free to regenerate — match recreates them on the next run.
    # Removing them frees the canonical "match AppStore <id>" names, which Apple
    # otherwise keeps reserved, forcing match to append a timestamp that no
    # longer matches PROVISIONING_PROFILE_SPECIFIER in the project.
    Spaceship::ConnectAPI::Profile.all(includes: "bundleId").each do |profile|
      bundle = profile.bundle_id&.identifier
      next unless ids.include?(bundle)
      next unless profile.profile_type.to_s.include?("APP_STORE")
      UI.important("Deleting #{profile.profile_type} \"#{profile.name}\" (#{bundle})")
      profile.delete!
    end

    UI.success("Done. Re-run the app's release workflow so match recreates them.")
  end

  desc "Add an App Store Connect user to the internal TestFlight group"
  lane :add_internal_tester do |options|
    require "spaceship"
    require "base64"

    query = options[:who] or UI.user_error!("Pass who:<name or email>")

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
    )

    # Internal testers must already be users on the account, so resolve the
    # person there rather than trusting a hand-typed address.
    users = Spaceship::ConnectAPI::User.all
    user = users.find do |u|
      addr = (u.respond_to?(:email) && u.email) || (u.respond_to?(:username) && u.username) || ""
      full = "#{u.first_name} #{u.last_name}"
      [addr, full].any? { |f| f.to_s.downcase.include?(query.to_s.downcase) }
    end
    UI.user_error!("No account user matches #{query.inspect}") if user.nil?

    email = (user.respond_to?(:email) && user.email) || user.username
    UI.important("Matched #{user.first_name} #{user.last_name} <#{email}> roles=#{user.roles.join(',')}")

    app = Spaceship::ConnectAPI::App.find(APP_ID)
    group = app.get_beta_groups.find(&:is_internal_group)

    require "net/http"
    require "json"

    # A new app has no beta group at all, so the uploaded build reaches nobody.
    # Create the internal group, with access to every build.
    if group.nil?
      uri = URI("https://api.appstoreconnect.apple.com/v1/betaGroups")
      req = Net::HTTP::Post.new(uri)
      req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
      req["Content-Type"] = "application/json"
      req.body = {
        data: {
          type: "betaGroups",
          attributes: {name: "Team", isInternalGroup: true, hasAccessToAllBuilds: true},
          relationships: {app: {data: {type: "apps", id: app.id}}}
        }
      }.to_json
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
      unless res.code.to_i.between?(200, 299)
        UI.error("HTTP #{res.code}")
        UI.error(res.body.to_s)
        UI.user_error!("Could not create the internal beta group.")
      end
      UI.success("Created internal group Team.")
      group = app.get_beta_groups.find(&:is_internal_group)
      UI.user_error!("Internal group created but not found on #{APP_ID}") if group.nil?
    end
    UI.important("Internal group: #{group.name} (#{group.id})")

    def asc_get(path)
      uri = URI("https://api.appstoreconnect.apple.com/#{path}")
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
      JSON.parse(res.body)
    end

    current = asc_get("v1/betaGroups/#{group.id}/betaTesters")["data"] || []
    already = current.any? { |t| t["attributes"]["email"].to_s.casecmp?(email.to_s) }
    if already
      UI.success("#{email} is already in #{group.name} — nothing to do.")
    else
      # Call the documented REST endpoint directly. spaceship's helpers for this
      # have moved between versions and its bulk endpoint no longer exists on
      # Apple's side, so going through the API contract is the stable option.
      require "net/http"
      require "json"

      uri = URI("https://api.appstoreconnect.apple.com/v1/betaTesters")
      req = Net::HTTP::Post.new(uri)
      req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
      req["Content-Type"] = "application/json"
      req.body = {
        data: {
          type: "betaTesters",
          attributes: {
            email: email,
            firstName: user.first_name,
            lastName: user.last_name
          },
          relationships: {
            betaGroups: {data: [{type: "betaGroups", id: group.id}]}
          }
        }
      }.to_json

      res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }

      unless res.code.to_i.between?(200, 299)
        UI.error("HTTP #{res.code}")
        UI.error(res.body.to_s)
        UI.user_error!("App Store Connect rejected the request.")
      end

      UI.success("Added #{email} to #{group.name}.")
    end

    UI.important("--- #{group.name} now contains ---")
    (asc_get("v1/betaGroups/#{group.id}/betaTesters")["data"] || []).each do |t|
      a = t["attributes"]
      UI.message("  #{a['email']} (#{a['firstName']} #{a['lastName']}) state=#{a['state']}")
    end
  end

  desc "Register the iOS and watch App IDs (HealthKit on the watch) and check the App Store Connect record"
  lane :register_ids do
    require "spaceship"
    require "base64"

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
    )

    healthkit = Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT
    [[APP_ID, "ComX", false], [WATCH_APP_ID, "ComX Watch", true], [CONTROLS_APP_ID, "ComX Watch Controls", false]].each do |identifier, name, needs_health|
      bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
      if bundle
        UI.message("App ID #{identifier} already registered")
      else
        bundle = Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
        UI.success("Registered App ID #{identifier}")
      end
      next unless needs_health

      if bundle.get_capabilities.any? { |c| c.capability_type == healthkit }
        UI.message("HealthKit already enabled on #{identifier}")
      else
        bundle.create_capability(healthkit)
        UI.success("Enabled HealthKit on #{identifier}")
      end
    end

    # The App Store Connect API cannot create the app record itself: it must
    # exist before the first upload (App Store Connect > Apps > +).
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    if app
      UI.success("App Store Connect record: #{app.name} (#{app.id})")
    else
      UI.user_error!(
        "No App Store Connect record for #{APP_ID} yet. Create it in App Store Connect > Apps > + > New App: " \
        "platform iOS, name ComX, bundle ID #{APP_ID}, SKU comx. Then re-run this workflow."
      )
    end
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    # CFBundleVersion must be unique per upload. Deriving it from the workflow
    # run number is fragile: the counter is per-workflow and drifts out of step
    # with what is actually on TestFlight, and Apple rejects a duplicate. Ask
    # App Store Connect what the highest build is and go one past it.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    )
    next_build = latest.to_i + 1
    UI.important("Latest build on TestFlight: #{latest} — uploading #{next_build}")

    increment_build_number(
      build_number: next_build,
      xcodeproj: "ios/#{APP_NAME}.xcodeproj"
    )

    match(
      type: "appstore",
      app_identifier: [APP_ID, WATCH_APP_ID, CONTROLS_APP_ID],
      api_key: api_key,
      readonly: false,
      storage_mode: "git",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "match-certs",
      git_basic_authorization: Base64.strict_encode64(
        "x-access-token:#{ENV.fetch('MATCH_GIT_TOKEN') { ENV.fetch('GITHUB_TOKEN') }}"
      )
    )

    # The project ships with automatic signing and an "iPhone Developer" identity,
    # which CI cannot use: xcodebuild disables automatic signing, then looks for a
    # development profile and fails. Pin the target to the profile match just
    # placed in the shared store.
    profile_name = ENV.fetch("sigh_#{APP_ID}_appstore_profile-name", "match AppStore #{APP_ID}")
    watch_profile_name = ENV.fetch("sigh_#{WATCH_APP_ID}_appstore_profile-name", "match AppStore #{WATCH_APP_ID}")
    controls_profile_name = ENV.fetch("sigh_#{CONTROLS_APP_ID}_appstore_profile-name", "match AppStore #{CONTROLS_APP_ID}")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/#{APP_NAME}.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID,
      targets: [APP_NAME]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/#{APP_NAME}.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: watch_profile_name,
      bundle_identifier: WATCH_APP_ID,
      targets: [WATCH_TARGET]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/#{APP_NAME}.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: controls_profile_name,
      bundle_identifier: CONTROLS_APP_ID,
      targets: [CONTROLS_TARGET]
    )

    build_app(
      workspace: "ios/#{APP_NAME}.xcworkspace",
      scheme: APP_NAME,
      export_method: "app-store",
      export_team_id: ENV.fetch("APPLE_TEAM_ID"),
      export_options: {
        provisioningProfiles: {
          APP_ID => profile_name, WATCH_APP_ID => watch_profile_name, CONTROLS_APP_ID => controls_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: File.read("../CHANGELOG.md")[/## v2\.0\n(.*?)(?=\n## v|\z)/m, 1].to_s.strip
    )

    UI.success("Build sent to TestFlight — available in ~10-30 min.")
  end
end
