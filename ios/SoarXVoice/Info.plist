<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>ComX</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ComX shares your position with the riders in your channel so everyone can see distance and direction.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>ComX shares your position with the riders in your channel so everyone can see distance and direction, including while the phone is locked in its pouch.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>ComX uses Bluetooth to connect your mute/unmute control buttons and your Garmin watch.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>ComX uses Bluetooth to connect your mute/unmute control buttons and your Garmin watch.</string>
	<key>NSCameraUsageDescription</key>
	<string>ComX does not record video. This access is required by the real-time audio framework the app is built on.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ComX needs microphone access to talk with the riders in your channel.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>soarxvoice</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.soarxvoice.app</string>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>comx-ciq</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.xavier.comx.connectiq</string>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>camera</string>
		<string>gcm-ciq</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Barlow-Bold.ttf</string>
		<string>Barlow-Medium.ttf</string>
		<string>Barlow-SemiBold.ttf</string>
		<string>BarlowCondensed-Bold.ttf</string>
		<string>BarlowCondensed-ExtraBold.ttf</string>
		<string>BarlowCondensed-SemiBold.ttf</string>
	</array>
</dict>
</plist>
